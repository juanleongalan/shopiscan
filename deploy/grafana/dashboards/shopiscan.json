      },
      "title": "Últimos hallazgos (PostgreSQL / pgvector)",
      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "format": "table",
          "rawSql": "SELECT created_at AS \"Fecha\", store_domain AS \"Tienda\", title AS \"Hallazgo\", severity AS \"Severidad\", owasp_category AS \"OWASP\", detail AS \"Descripción\", remediation AS \"Solución sugerida\" FROM finding_embeddings ORDER BY created_at DESC LIMIT 30;",
          "rawQuery": true
        }
      ]
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "description": "Los tipos de hallazgo más frecuentes en todo el histórico de escaneos (todas las tiendas). Útil para ver qué problemas se repiten más allá de un escaneo puntual.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        }
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "id": 8,
      "options": {
        "showHeader": true
      },
      "title": "Hallazgos más frecuentes (histórico, todas las tiendas)",
      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "format": "table",
          "rawSql": "SELECT title AS \"Hallazgo\", severity AS \"Severidad\", owasp_category AS \"OWASP\", (array_agg(detail ORDER BY created_at DESC))[1] AS \"Descripción\", (array_agg(remediation ORDER BY created_at DESC))[1] AS \"Solución sugerida\", COUNT(*) AS \"Veces visto\", COUNT(DISTINCT store_domain) AS \"Tiendas distintas\" FROM finding_embeddings GROUP BY title, severity, owasp_category ORDER BY \"Veces visto\" DESC LIMIT 20;",
          "rawQuery": true
        }
      ]
    }
